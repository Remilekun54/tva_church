# Django Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=tva.ng,www.tva.ng
CSRF_TRUSTED_ORIGINS=https://tva.ng,https://www.tva.ng

# SSL settings - keep these FALSE until your SSL certificate is working,
# then flip each one to True once HTTPS is live.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# cPanel MySQL Database Settings
DB_NAME=cpaneluser_dbname
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
