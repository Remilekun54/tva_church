# ==============================================================================
# Django Environment Variables Template (.env.example)
# ==============================================================================

# Local dev: DEBUG=True | Production/Live: DEBUG=False
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key

# Comma-separated allowed hosts and CSRF origins
ALLOWED_HOSTS=tva.ng,www.tva.ng,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tva.ng,https://www.tva.ng

# ==============================================================================
# Database Configuration
# ==============================================================================
# Set USE_SQLITE=True to use local SQLite (db.sqlite3).
# Set USE_SQLITE=False on cPanel to use MySQL.
USE_SQLITE=True

# cPanel / Live MySQL Settings (used when USE_SQLITE=False)
DB_NAME=cpaneluser_dbname
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Alternatively, for Cloud hosting (Render / Railway / Heroku):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ==============================================================================
# SSL / HTTPS security settings (cPanel shared hosting)
# Keep False until your SSL certificate is installed, then set to True on live.
# ==============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
